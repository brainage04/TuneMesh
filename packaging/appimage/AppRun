#!/bin/sh
# Spotless AppImage entry point.
#   ./Spotless-<version>-<arch>.AppImage [--library <folder>]   the app
#   ./Spotless-<version>-<arch>.AppImage worker [args]          the download worker
# A symlink to the AppImage named spotless-worker also starts the worker.
APPDIR=${APPDIR:-$(dirname "$(readlink -f "$0")")}
export APPDIR

# linuxdeploy's wrapper has already sourced the GTK hook (GTK, GLib and
# GdkPixbuf paths) before this script runs.

# The worker uses the bundled ffmpeg/ffprobe; the app finds the worker next
# to its own binary.
export SPOTLESS_FFMPEG_DIR="$APPDIR/usr/bin"

case $(basename "${ARGV0:-$0}") in
    spotless-worker*) exec "$APPDIR/usr/bin/spotless-worker" "$@" ;;
esac
if [ "${1:-}" = worker ]; then
    shift
    exec "$APPDIR/usr/bin/spotless-worker" "$@"
fi
exec "$APPDIR/usr/bin/spotless" "$@"
